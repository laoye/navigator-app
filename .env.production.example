# Production environment template.
# Copy to `.env.production` (gitignored) and fill real values.
# Used by `yarn android:release` / `yarn bundle:android` / `yarn ios:release`
# via ENVFILE (react-native-config 选文件依据)。

APP_NAME=ForBox
APP_IDENTIFIER=com.forboxexpress.app
APP_LINK_PREFIX=forbox

# Android 版本号:versionCode 每次传 Play 必须递增(纯整数);versionName 是展示用字符串。
# iOS 的版本号在 Xcode 工程里(MARKETING_VERSION / CURRENT_PROJECT_VERSION),与此无关。
ANDROID_VERSION_CODE=1
ANDROID_VERSION_NAME=1.0.0

# Production fleetbase backend
FLEETBASE_HOST=https://api.your-prod-host.com
FLEETBASE_KEY=

# Google Maps key — 给 release 单独签一把 key，Application restriction 限制到
# com.forboxexpress.app (Android) / Bundle ID (iOS)；dev / debug key 不要混用。
GOOGLE_MAPS_API_KEY=

# 洛杉矶市中心(司机主要作业区域)
DEFAULT_COORDINATES=34.0522,-118.2437
FACEBOOK_APP_ID=0
FACEBOOK_CLIENT_TOKEN=placeholder

# transistorsoft background-geolocation license：按 bundle id 绑，需要在
# transistorsoft 后台为 com.forboxexpress.app 单独签发 prod license。dev/debug 不需要。
TRANSISTORSOFT_LICENSE_KEY=
